# Copy to `.env` locally. Never commit `.env`.
# See docs/USAGE.md for the operator walkthrough.

# Model: any OpenAI-compatible endpoint. LiteLLM is just another URL.
# TYTO_BASE_URL=http://127.0.0.1:11434/v1
# TYTO_API_KEY=
# TYTO_MODEL=gpt-oss:20b

# Optional Anthropic-shaped HTTP (not required)
# ANTHROPIC_API_KEY=

# The host does not read this file; export variables in your shell.
# Host kernel (loopback only). Tokens are generated per start into
# ~/.tyto/tokens/ (0600). Set TYTO_HOST_TOKEN only to pin the power token.
# TYTO_HOST_TOKEN=
# TYTO_HOME=
# TYTO_BIND=127.0.0.1
# TYTO_PORT=7420
# Optional comma-separated origins to seed (Run still grants the URL you type)
# TYTO_ALLOW=

# Launched browser (empty Tyto profile by default)
# TYTO_BROWSER=chrome
# TYTO_PROFILE=
# TYTO_SESSION_DIR=
# TYTO_NO_OPEN=0

# Live Chrome tests (opt-in; never required for `npm test`)
# TYTO_LIVE=0
