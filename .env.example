# Copy to `.env` locally if you like; Tyto reads environment variables, not this file. Never commit `.env`.

# Compiler (slice 6+): default is Claude Code headless on your Max plan — no key needed.
# Do NOT export ANTHROPIC_API_KEY for Claude Code; it would switch billing to the API.
# TYTO_COMPILER=claude

# Optional OpenAI-compatible compiler (slice 9), e.g. local Ollama or a proxy. LiteLLM is just another URL.
# TYTO_COMPILER=openai
# TYTO_BASE_URL=http://127.0.0.1:11434/v1
# TYTO_MODEL=gpt-oss:20b
# TYTO_API_KEY=

# Where Tyto keeps recipes, traces, and locks (files are 0600).
# TYTO_HOME=~/.tyto

# Live tests (opt-in; `npm run test:live` sets TYTO_LIVE=1). Needs agent-browser installed.
# TYTO_LIVE=0
