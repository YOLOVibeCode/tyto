{
  "name": "tyto",
  "private": true,
  "type": "module",
  "description": "Learn-once, replay-fast browser recipes and one-call page briefs, on top of agent-browser.",
  "workspaces": [
    "packages/core",
    "packages/llm"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "TYTO_LIVE=1 vitest run",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p packages/llm",
    "secrets:scan": "node scripts/check-secrets.mjs",
    "lint:imports": "node scripts/check-core-imports.mjs",
    "check": "npm run lint:imports && npm run secrets:scan && npm test && npm run typecheck"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
